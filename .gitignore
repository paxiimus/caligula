# ---------------------------------------------------------------
# Caligula is a public repo. If in doubt, ignore it.
# .gitignore does not untrack files already committed and does not
# remove anything from history: check `git status` before every push.
# ---------------------------------------------------------------

# Dependencies
node_modules/

# Expo and Metro
.expo/
.expo-shared/
expo-env.d.ts
.metro-health-check*
dist/
web-build/

# Native projects (generated by `expo prebuild`; app.config.ts is the source of truth)
android/
ios/

# Build output
build/
coverage/
*.tsbuildinfo
*.apk
*.aab
*.ipa
*.app
*.dSYM/
*.dSYM.zip

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.secrets/

# Android signing
*.jks
*.keystore
keystore.properties

# Apple signing
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# EAS and store credentials (Google service account keys, local credentials)
credentials.json
credentials/
*service-account*.json
*service_account*.json
play-store*.json
api-key*.json

# App exports: real personal data (Settings, Export writes caligula-YYYY-MM-DD.json)
caligula-*.json

# Local databases pulled off a device
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Source spreadsheets (CoFID is downloaded from GOV.UK; only src/data/foods.json is committed)
*.xlsx
*.xls

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.pnpm-debug.log*

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
# Additional ignores
RELEASE.md
release.md
eslint.json

