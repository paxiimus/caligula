{
  "name": "caligula",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/*.test.ts",
    "check:network": "! grep -rnwE 'fetch|XMLHttpRequest|WebSocket' app src --include=*.ts --include=*.tsx",
    "build:food-db": "node scripts/build-food-db.mjs",
    "build:apk": "eas build -p android --profile preview",
    "build:aab": "eas build -p android --profile production",
    "submit:internal": "eas submit -p android --profile production --latest",
    "submit:closed": "eas submit -p android --profile closed --latest",
    "submit:store": "eas submit -p android --profile store --latest"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-sharing": "~14.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "jotai": "^2.12.0",
    "react": "~19.1.0",
    "react-dom": "19.1.0",
    "react-native": "~0.81.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
